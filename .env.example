# Copy to .env and fill in. Defaults below match docker-compose.yml (local dev).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=poseidon
DB_USER=poseidon
DB_PASSWORD=localdev
# "disable" for local docker Postgres; leave unset (defaults to "require") for RDS
DB_SSLMODE=disable

SAM_GOV_API=
AWS_BEARER_TOKEN_BEDROCK=

# Streamlit dashboard -> API
API_URL=http://localhost:8000
